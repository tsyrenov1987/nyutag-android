<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zurkhai_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/zurkhai_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zurkhai_widget"
        android:textColor="@color/widget_gold"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zurkhai_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:textColor="@color/widget_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zurkhai_haircut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_quiet"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/zurkhai_favorable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Распорка: голый View в RemoteViews до Android 12 не разрешён. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/zurkhai_sagaalgan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_sky"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
